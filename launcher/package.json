{
  "name": "farmaplus-launcher",
  "version": "1.0.0",
  "description": "Launcher para Farmaplus PWA",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "Farmaplus",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.6.0",
    "mysql2": "^3.22.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.farmaplus.launcher",
    "productName": "Farmaplus Launcher",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Farmaplus Launcher",
      "runAfterFinish": true
    },
    "files": [
      "index.js",
      "preload.js",
      "package.json",
      "icon.ico",
      "icon.png",
      "node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "xlsx",
        "name": "Excel Spreadsheet",
        "role": "Viewer",
        "description": "Abrir con Farmaplus"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Spreadsheet",
        "role": "Viewer",
        "description": "Abrir con Farmaplus"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "role": "Viewer",
        "description": "Abrir con Farmaplus"
      }
    ]
  }
}
