{
  "name": "farmaplus-launcher",
  "version": "1.0.0",
  "description": "Launcher para Farmaplus PWA",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "Farmaplus",
  "license": "ISC",
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.farmaplus.launcher",
    "productName": "Farmaplus Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "fileAssociations": [
      {
        "ext": "xlsx",
        "name": "Excel Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "role": "Viewer"
      }
    ]
  }
}
