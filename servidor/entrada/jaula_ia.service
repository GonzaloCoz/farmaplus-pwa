[Unit]
Description=Servicio aislado de inferencia local Ollama bajo jaula cgroups v2
After=network-online.target postgresql.service

[Service]
Type=exec
User=ollama
Group=ollama
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_KEEP_ALIVE=5m"
Environment="OLLAMA_NUM_PARALLEL=1"
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5s

# Jaula estricta cgroups v2 para preservar CPU e I/O de PostgreSQL
CPUQuota=150%
MemoryMax=2200M
MemorySwapMax=0
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
