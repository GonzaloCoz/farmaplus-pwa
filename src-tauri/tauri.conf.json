{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farmaplus",
  "version": "0.1.0",
  "identifier": "com.farmaplus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Farmaplus Desktop",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist --disable-features=CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["xlsx", "xls", "csv"],
        "name": "Planilla de Inventario Farmaplus",
        "description": "Abrir archivo de stock en Farmaplus Desktop",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3QTk4NzE5NzY2Qzg2MEQKUldRTmhteDJHWWVwTjBPSXNkaG5KQzc5aEY0eFU3YjZacEN4U1ZsaDN3eUo2RkVSNmRxQ2M1M2oK",
      "endpoints": [
        "https://github.com/GonzaloCoz/farmaplus-pwa/releases/latest/download/latest.json"
      ]
    }
  }
}
